# Telegram configuration
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# Product configuration
PRODUCT_NAME="iPhone Example 256 GB"
PART_NUMBER=MK2D4QL/A

# Apple pickup API configuration
APPLE_URL=https://www.apple.com/it/shop/retail/pickup-message
# Optional: automatically derived from APPLE_URL if omitted
APPLE_REFERER=https://www.apple.com/it/shop/
# Optional: defaults to en-US,en;q=0.9
ACCEPT_LANGUAGE=it-IT,it;q=0.9

# Postal codes / locations to query
# Supported formats: "postcode:Label, postcode2:Label2" or JSON object
LOCATIONS="80121:Napoli centro, 80125:Napoli Fuorigrotta"

# Allowed stores filter (matched case-insensitively against Apple's store name)
# Supported formats: "keyword:Official Store Name, ..." or JSON object
# Leave empty to monitor all stores returned by Apple.
ALLOWED_STORES="campania:Apple Campania - Marcianise"

# Runtime configuration
# Polling interval in seconds (minimum: 30)
INTERVAL=180
# Path to the JSON file used to persist store availability state
STATE_FILE=apple_stock_state.json
# HTTP timeouts in seconds
REQUEST_TIMEOUT=25
TELEGRAM_TIMEOUT=20
